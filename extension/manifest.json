{
  "manifest_version": 3,
  "name": "AI Studio Plus",
  "version": "1.0.2",
  "description": "Searchable infinite history sidebar, fast actions, hover-to-peek, smart user bubble folding, and GPU relief for Google AI Studio.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*", "https://aistudio.google.cn/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://aistudio.google.com/*", "https://aistudio.google.cn/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["https://aistudio.google.com/*", "https://aistudio.google.cn/*"]
    }
  ]
}
